# =============================================================================
# Punjab Air Quality System - Environment Variables Template
# Copy this file to .env and insert your personal API keys
# =============================================================================

# EPA Punjab AQMS Live API (STR-01-EPAPUNJAB)
EPA_PUNJAB_BASE_URL=https://api.epd-aqms-pk.com
EPA_PUNJAB_API_KEY=7b2f49c1e0e447c6a2bde74b81f51a87

# NASA FIRMS VIIRS Active Fire Satellite Feed (STR-05-FIRMS)
# Obtain a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# IQAir AirVisual Community/Reference API (STR-06-IQAIR)
# Obtain key at: https://www.iqair.com/air-pollution-data-api
IQAIR_API_KEY=your_iqair_api_key_here

# Copernicus Atmospheric Monitoring Service (ADS) API (STR-07-CAMS)
# Obtain key at: https://ads.atmosphere.copernicus.eu/
ECMWF_ADS_API_KEY=your_cams_api_key_here

# Application Mode ('simulation' or 'live')
STREAM_MODE=live

# Database Backend Configuration (PostgreSQL 16 & TimescaleDB 2.14)
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/punjab_air_quality
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=punjab_air_quality
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
USE_DATABASE_BACKEND=true

# High-Speed Cache & SSE Fan-Out (Redis 7.2)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
USE_REDIS_CACHE=true

